% NeurIPS-style paper template (simplified, public-domain reimplementation
% of the NeurIPS conference style sufficient for layout compliance).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_2024}[2024/03/01 NeurIPS 2024 style]

\RequirePackage{geometry}
\geometry{letterpaper, total={5.5in,9in}, top=1in}

\renewcommand{\@maketitle}{%
  \begin{center}%
    {\LARGE\bfseries \@title \par}%
    \vskip 1em%
    {\large \@author \par}%
    \vskip 0.5em%
  \end{center}%
}

\renewcommand{\section}{\@startsection{section}{1}{\z@}%
  {-1.0ex \@plus -0.5ex \@minus -0.2ex}%
  {0.6ex \@plus 0.2ex}%
  {\normalfont\large\bfseries}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}%
  {-0.8ex \@plus -0.4ex \@minus -0.2ex}%
  {0.4ex \@plus 0.2ex}%
  {\normalfont\normalsize\bfseries}}

\renewenvironment{abstract}{%
  \begin{center}\textbf{Abstract}\end{center}%
  \begin{quotation}\noindent\small}{\end{quotation}}

\endinput
